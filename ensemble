#!/usr/bin/env bash
# ensemble: start/stop/restart/status the Ensemble agent dashboard.
#
# Usage:
#   ensemble start [--port N]
#   ensemble stop
#   ensemble restart [--port N]
#   ensemble status
#   ensemble logs       # tail -f the log file
#   ensemble open       # open the dashboard in the default browser
#
# State:
#   PID file: ~/.ensemble/server.pid
#   Logs:     ~/Library/Logs/ensemble.log
#
# Tip: symlink this script onto your PATH so you can run it from anywhere:
#   ln -s "$(pwd)/ensemble" ~/.local/bin/

set -euo pipefail

# Resolve symlinks so the script works when invoked via a PATH symlink.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  D="$(cd -P "$(dirname "$SOURCE")" >/dev/null && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$D/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null && pwd)"
SCRIPT="$DIR/dashboard.py"
PORT="${ENSEMBLE_PORT:-8765}"
STATE_DIR="$HOME/.ensemble"
PID_FILE="$STATE_DIR/server.pid"
LOG="$HOME/Library/Logs/ensemble.log"

mkdir -p "$STATE_DIR" "$(dirname "$LOG")"

url() { echo "http://127.0.0.1:$PORT"; }

running_pid() {
  # Returns the live PID (empty if none).
  if [[ -f "$PID_FILE" ]]; then
    local p
    p="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null; then
      echo "$p"
      return 0
    fi
  fi
  # Fallback: anyone listening on the port?
  lsof -ti "tcp:$PORT" 2>/dev/null | head -1 || true
}

cmd_start() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) PORT="$2"; shift 2 ;;
      *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
  done
  local pid
  pid="$(running_pid)"
  if [[ -n "$pid" ]]; then
    echo "Already running (pid $pid). $(url)"
    return 0
  fi
  if [[ ! -f "$SCRIPT" ]]; then
    echo "error: $SCRIPT not found" >&2
    exit 1
  fi
  # Ensure the headless-PTY dependency (ptyprocess) is installed for this python3;
  # without it, launching an agent fails. --break-system-packages covers PEP 668
  # (externally-managed) Pythons (homebrew / recent macOS).
  if ! python3 -c "import ptyprocess" 2>/dev/null; then
    echo "Installing dependencies (ptyprocess)…"
    python3 -m pip install --user -r "$DIR/requirements.txt" 2>/dev/null \
      || python3 -m pip install --user --break-system-packages -r "$DIR/requirements.txt" \
      || echo "warning: could not auto-install ptyprocess — run 'python3 -m pip install -r $DIR/requirements.txt'" >&2
  fi
  # Detach: new session via setsid-equivalent (`nohup` + `&` + `disown`), redirect stdio.
  nohup python3 "$SCRIPT" --port "$PORT" >>"$LOG" 2>&1 </dev/null &
  local new_pid=$!
  echo "$new_pid" > "$PID_FILE"
  disown "$new_pid" 2>/dev/null || true
  # Quick health check.
  sleep 0.3
  if kill -0 "$new_pid" 2>/dev/null; then
    echo "Started (pid $new_pid). $(url)"
  else
    echo "Failed to start. Last log lines:" >&2
    tail -n 20 "$LOG" >&2 || true
    rm -f "$PID_FILE"
    exit 1
  fi
}

cmd_stop() {
  local pid
  pid="$(running_pid)"
  if [[ -z "$pid" ]]; then
    rm -f "$PID_FILE"
    echo "Not running."
    return 0
  fi
  kill "$pid" 2>/dev/null || true
  for _ in 1 2 3 4 5; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.2
  done
  kill -9 "$pid" 2>/dev/null || true
  rm -f "$PID_FILE"
  echo "Stopped (was pid $pid)."
}

cmd_status() {
  local pid
  pid="$(running_pid)"
  if [[ -n "$pid" ]]; then
    echo "Running (pid $pid) — $(url)"
    echo "Log: $LOG"
  else
    echo "Not running."
  fi
}

cmd_logs() { exec tail -n 50 -f "$LOG"; }

cmd_open() { open "$(url)"; }

# Pull the latest code and restart. Invoked by the in-app "Update now" button
# (the server spawns `ensemble update` detached so it survives the restart).
cmd_update() {
  echo "Updating…"
  git -C "$DIR" fetch --quiet || { echo "git fetch failed" >&2; exit 1; }
  local up
  up="$(git -C "$DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
  if [[ -n "$up" ]]; then
    git -C "$DIR" reset --hard "$up" --quiet
  else
    echo "warning: no upstream to update from" >&2
  fi
  # Refresh deps in case requirements changed.
  python3 -c "import ptyprocess" 2>/dev/null \
    || python3 -m pip install --user -r "$DIR/requirements.txt" 2>/dev/null \
    || python3 -m pip install --user --break-system-packages -r "$DIR/requirements.txt" 2>/dev/null \
    || true
  # Restart: prefer the LaunchAgent if it's loaded, else the manual process.
  local label="com.ensemble.dashboard"
  if launchctl print "gui/${UID}/${label}" >/dev/null 2>&1; then
    launchctl kickstart -k "gui/${UID}/${label}"
    echo "Restarted via launchd ($label)."
  else
    cmd_stop; cmd_start
  fi
}

action="${1:-status}"
shift || true

case "$action" in
  start)   cmd_start "$@" ;;
  stop)    cmd_stop ;;
  restart) cmd_stop; cmd_start "$@" ;;
  status)  cmd_status ;;
  logs)    cmd_logs ;;
  open)    cmd_open ;;
  update)  cmd_update ;;
  -h|--help|help)
    sed -n '2,12p' "$0"
    ;;
  *)
    echo "Usage: $0 {start [--port N] | stop | restart [--port N] | status | logs | open | update}" >&2
    exit 2
    ;;
esac
